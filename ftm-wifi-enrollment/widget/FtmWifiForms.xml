<?xml version="1.0" encoding="UTF-8"?>
<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">

    <!-- ==================== FILTER FORM ==================== -->
    <form name="FindUsersFilter" type="single"
        target="FindAuthorizedUsers" default-map-name="parameters">
        <field name="department" title="Department">
            <text-find/>
        </field>
        <field name="vlanTier" title="WiFi Tier">
            <drop-down allow-empty="true">
                <option key=""      description="-- All --"/>
                <option key="VLAN10" description="FTM-Staff (VLAN10 - Leadership/IT)"/>
                <option key="VLAN20" description="FTM-Staff2 (VLAN20 - General Staff)"/>
            </drop-down>
        </field>
        <field name="searchButton" title="Search">
            <submit button-type="button"/>
        </field>
        <field name="addNewLink" title=" ">
            <hyperlink description="Add New User" target="EditAuthorizedUser"/>
        </field>
        <field name="importLink" title=" ">
            <hyperlink description="Import from Excel" target="UploadWifiUsers"/>
        </field>
    </form>

    <!-- Standalone Export CSV - renders outside FindUsersFilter form as plain GET link -->
    <form name="ExportCsvForm" type="single" target="ExportAuthorizedUsersCsv">
        <field name="exportCsv" title=" ">
            <hyperlink description="Export CSV" target="ExportAuthorizedUsersCsv"
                style="buttontext"/>
        </field>
    </form>

    <!-- ==================== USER LIST FORM ==================== -->
    <form name="AuthorizedUserList" type="list"
        list-name="userList"
        odd-row-style="alternate-row"
        default-table-style="basic-table hover-bar">
        <field name="employeeId"   title="Employee ID">
            <hyperlink description="${employeeId}"
                target="EditAuthorizedUser">
                <parameter param-name="employeeId"/>
            </hyperlink>
        </field>
        <field name="fullName"     title="Full Name">      <display/></field>
        <field name="username"     title="Username">       <display/></field>
        <field name="department"   title="Department">     <display/></field>
        <field name="ftmStaffVlan10" title="WiFi Tier">
            <display description="${ftmStaffVlan10 == 'Y' ? 'FTM-Staff (VLAN10)' : 'FTM-Staff2 (VLAN20)'}"/>
        </field>
        <field name="deviceQuota"  title="Device Quota">  <display/></field>
        <field name="active" title="Active">
            <display description="${active ? 'Yes' : 'No'}"/>
        </field>
        <field name="editAction" title=" ">
            <hyperlink description="Edit" target="EditAuthorizedUser">
                <parameter param-name="employeeId"/>
            </hyperlink>
        </field>
        <field name="deactivateAction" title=" " use-when="active">
            <hyperlink description="Deactivate" target="DeactivateUser">
                <parameter param-name="employeeId"/>
            </hyperlink>
        </field>
        <field name="activateAction" title=" " use-when="!active">
            <hyperlink description="Activate" target="ActivateUser">
                <parameter param-name="employeeId"/>
            </hyperlink>
        </field>
    </form>

    <!-- ==================== EDIT / ADD FORM ==================== -->
    <form name="EditUserForm" type="single"
        default-map-name="user">

        <alt-target use-when="user == null" target="CreateAuthorizedUser"/>
        <alt-target use-when="user != null" target="UpdateAuthorizedUser"/>

        <!-- Show VLAN warning from last service call if present -->
        <field name="vlanWarning" title=" " use-when="vlanWarning != null">
            <display description="${vlanWarning}"/>
        </field>

        <field name="employeeId" title="Employee ID *">
            <text default-value="${user?.employeeId}"/>
        </field>
        <field name="fullName" title="Full Name *">
            <text default-value="${user?.fullName}"/>
        </field>
        <field name="username" title="Username *">
            <text default-value="${user?.username}"/>
        </field>
        <field name="department" title="Department">
            <text default-value="${user?.department}"/>
        </field>
        <field name="position" title="Position">
            <text default-value="${user?.position}"/>
        </field>
        <field name="deviceQuota" title="Device Quota">
            <text default-value="${user?.deviceQuota ?: 2}"/>
        </field>
        <field name="ftmStaffVlan10" title="WiFi Tier">
            <drop-down>
                <option key="false" description="FTM-Staff2 (VLAN20 - General Staff)"/>
                <option key="true"  description="FTM-Staff (VLAN10 - Leadership/IT)"/>
            </drop-down>
        </field>
        <field name="notes" title="Notes">
            <textarea rows="3" default-value="${user?.notes}"/>
        </field>
        <field name="submitButton" title="Save">
            <submit button-type="button"/>
        </field>

        <field name="cancelLink" title=" ">
            <hyperlink description="Cancel" target="FindAuthorizedUsers"/>
        </field>
    </form>

    <!-- ==================== ENROLLED DEVICES LIST (per-user, in EditAuthorizedUser) ==================== -->
    <form name="EnrolledDevicesList" type="list"
        list-name="enrolledDevices"
        default-table-style="basic-table hover-bar">
        <field name="deviceLabel"  title="Device Label">  <display/></field>
        <field name="serialNumber" title="Serial #">       <display/></field>
        <field name="cn"           title="Cert CN">        <display/></field>
        <field name="status"       title="Status">         <display/></field>
        <field name="requestTime"  title="Requested">      <display/></field>
        <field name="enrolledAt"   title="Enrolled">       <display/></field>
        <field name="certExpiry"   title="Cert Expires">   <display/></field>
        <field name="radiusActive" title="RADIUS">         <display/></field>
        <field name="revokeAction" title=" ">
            <hyperlink description="Revoke" target="RevokeDevice"
                confirmation="Revoke this device? RADIUS access will be disabled.">
                <parameter param-name="deviceId" from-field="id"/>
            </hyperlink>
        </field>
        <field name="deleteAction" title=" ">
            <hyperlink description="Delete" target="DeleteDevice"
                confirmation="Permanently delete this enrollment record?">
                <parameter param-name="deviceId" from-field="id"/>
            </hyperlink>
        </field>
    </form>

    <!-- ==================== DEVICE ROSTER LIST (all devices, read-only) ==================== -->
    <form name="DeviceRosterList" type="list"
        list-name="deviceList"
        odd-row-style="alternate-row"
        default-table-style="basic-table hover-bar">
        <field name="fullName"     title="Staff Name">     <display/></field>
        <field name="username"     title="Username">       <display/></field>
        <field name="vlanTier"     title="WiFi Tier">      <display/></field>
        <field name="quotaDisplay" title="Devices (used/quota)"> <display/></field>
        <field name="deviceLabel"  title="Device Label">  <display/></field>
        <field name="serialNumber" title="Serial #">       <display/></field>
        <field name="status"       title="Status">         <display/></field>
        <field name="requestTime"  title="Requested">      <display/></field>
        <field name="certExpiry"   title="Cert Expires">   <display/></field>
        <field name="radiusActive" title="RADIUS">         <display/></field>
    </form>

    <!-- ==================== PENDING DEVICES LIST (admin approval queue) ==================== -->
    <form name="PendingDevicesList" type="list"
        list-name="pendingDevices"
        odd-row-style="alternate-row"
        default-table-style="basic-table hover-bar">
        <field name="requestTime"  title="Requested">      <display/></field>
        <field name="fullName"     title="Staff Name">     <display/></field>
        <field name="username"     title="Username">       <display/></field>
        <field name="deviceLabel"  title="Device Label">  <display/></field>
        <field name="serialNumber" title="Serial #">       <display/></field>
        <field name="cn"           title="Cert CN">        <display/></field>
        <field name="requestIp"    title="From IP">        <display/></field>
        <field name="approveAction" title=" ">
            <hyperlink description="Approve" target="ApproveDevice">
                <parameter param-name="deviceId" from-field="id"/>
            </hyperlink>
        </field>
        <field name="rejectAction" title=" ">
            <hyperlink description="Reject" target="RevokeDevice"
                confirmation="Reject and revoke this enrollment request?">
                <parameter param-name="deviceId" from-field="id"/>
            </hyperlink>
        </field>
    </form>

    <!-- ==================== ALL DEVICES ADMIN LIST (full management) ==================== -->
    <form name="AllDevicesAdminList" type="list"
        list-name="allDevices"
        odd-row-style="alternate-row"
        default-table-style="basic-table hover-bar">
        <field name="requestTime"  title="Requested">      <display/></field>
        <field name="fullName"     title="Staff Name">     <display/></field>
        <field name="username"     title="Username">       <display/></field>
        <field name="vlanTier"     title="WiFi Tier">      <display/></field>
        <field name="deviceLabel"  title="Device Label">  <display/></field>
        <field name="serialNumber" title="Serial #">       <display/></field>
        <field name="status"       title="Status">         <display/></field>
        <field name="enrolledAt"   title="Enrolled">       <display/></field>
        <field name="certExpiry"   title="Cert Expires">   <display/></field>
        <field name="radiusActive" title="RADIUS">         <display/></field>
        <field name="approvedBy"   title="Approved By">    <display/></field>
        <field name="revokeAction" title=" ">
            <hyperlink description="Revoke" target="RevokeDevice"
                confirmation="Revoke device? RADIUS access will be disabled.">
                <parameter param-name="deviceId" from-field="id"/>
            </hyperlink>
        </field>
        <field name="deleteAction" title=" ">
            <hyperlink description="Delete" target="DeleteDevice"
                confirmation="Permanently delete this enrollment record?">
                <parameter param-name="deviceId" from-field="id"/>
            </hyperlink>
        </field>
    </form>

    <!-- ==================== STATUS FILTER FORM (for Device Admin / Roster) ==================== -->
    <form name="DeviceStatusFilter" type="single"
        target="DeviceAdmin" default-map-name="parameters">
        <field name="statusFilter" title="Filter by Status">
            <drop-down allow-empty="false">
                <option key="all"      description="-- All --"/>
                <option key="pending"  description="Pending"/>
                <option key="approved" description="Approved"/>
                <option key="enrolled" description="Enrolled"/>
                <option key="revoked"  description="Revoked"/>
            </drop-down>
        </field>
        <field name="filterButton" title=" ">
            <submit button-type="button"/>
        </field>
    </form>

    <!-- ==================== EXCEL UPLOAD FORM ==================== -->
    <form name="UploadExcelForm" type="upload"
        target="PreviewWifiImport">
        <field name="uploadedFile" title="Excel File (.xlsx or .xls)">
            <file/>
        </field>

        <field name="previewButton" title="Preview Import">
            <submit button-type="button"/>
        </field>
    </form>

    <!-- ==================== IMPORT PREVIEW TABLE ==================== -->
    <form name="ImportPreviewTable" type="list"
        list-name="previewList"
        default-table-style="basic-table hover-bar">
        <field name="action"         title="Action">
            <display description="${action}"/>
        </field>
        <field name="employeeId"     title="Employee ID">   <display/></field>
        <field name="fullName"       title="Full Name">     <display/></field>
        <field name="username"       title="Username">      <display/></field>
        <field name="department"     title="Department">    <display/></field>
        <field name="ftmStaffVlan10" title="VLAN10">
            <display description="${ftmStaffVlan10 ? 'Yes' : 'No'}"/>
        </field>
        <field name="deviceQuota"    title="Quota">         <display/></field>
    </form>

    <!-- Commit button below the preview table -->
    <form name="ImportCommitForm" type="single"
        target="CommitWifiImport">
        <field name="uploadedFile">
            <hidden/>
        </field>
        <field name="fileName">
            <hidden/>
        </field>
        <field name="previewOnly" title=" ">
            <hidden value="false"/>
        </field>
        <field name="commitButton" title="Confirm Import">
            <submit button-type="button"/>
        </field>
        <field name="cancelLink" title=" ">
            <hyperlink description="Cancel" target="FindAuthorizedUsers"/>
        </field>
    </form>

    <!-- ==================== IMPORT SUMMARY ==================== -->
    <form name="ImportSummaryForm" type="single">
        <field name="errorsTitle" title=" " use-when="errorList != null &amp;&amp; !errorList.isEmpty()">
            <display description="Errors:"/>
        </field>
        <field name="warningsTitle" title=" " use-when="warnings != null &amp;&amp; !warnings.isEmpty()">
            <display description="Warnings (action required):"/>
        </field>
        <field name="backLink" title=" ">
            <hyperlink description="Back to User List" target="FindAuthorizedUsers"/>
        </field>
    </form>

</forms>
