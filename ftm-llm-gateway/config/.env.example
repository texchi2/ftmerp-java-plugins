# ftm-llm-gateway — proxy config for MacStudio
# Copy to: ~/.config/free-claude-code/.env
# (free-claude-code proxy reads this location by default)

# Auth token — clients must launch claude with ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_AUTH_TOKEN="freecc"

# Providers (all local on MacStudio)
OLLAMA_BASE_URL="http://localhost:11434"
LM_STUDIO_BASE_URL="http://localhost:8090"   # MLX-VLM server

# Model tier routing
# Clients use /model picker to switch mid-session without restarting
MODEL_HAIKU="ollama/phi3:3.8b"
MODEL_SONNET="ollama/llama3.3:70b"
MODEL_OPUS="ollama/ofbiz-think:latest"
MODEL="ollama/mistral:7b-instruct"

# Performance: suppress Claude Code startup probes (save tokens)
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true
ENABLE_SUGGESTION_MODE_SKIP=true
ENABLE_FILEPATH_EXTRACTION_MOCK=true

ENABLE_MODEL_THINKING=true

# Rate limits (local models have no external rate limit)
PROVIDER_RATE_LIMIT=10
PROVIDER_RATE_WINDOW=1
PROVIDER_MAX_CONCURRENCY=3

# Timeouts — generous for large models (llama3.3:70b, gpt-oss:120b)
HTTP_READ_TIMEOUT=600
HTTP_WRITE_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10

# Disable unused services
MESSAGING_PLATFORM="none"
VOICE_NOTE_ENABLED=false

# Debug (enable temporarily when troubleshooting)
LOG_RAW_API_PAYLOADS=false
LOG_API_ERROR_TRACEBACKS=false
