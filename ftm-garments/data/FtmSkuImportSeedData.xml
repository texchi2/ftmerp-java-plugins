<!-- SKU workbook import (DESIGN_sku_workbook_import_2026-10-22): the permission every import screen and service
     requires, and the import's status items. SEED only - no group holds the permission here: the grant to FULLADMIN
     is demo-reader data (FtmSkuImportDemoData.xml), because FULLADMIN itself is demo data and a seed-only database
     (the test database) has no such group (FK SEC_GRP_PERM_GRP). Any other group gets it by the owner's word.
     The sheet map for the owner's workbooks is PRIVATE data and is not in this repository. -->
<entity-engine-xml>
    <SecurityPermission permissionId="FTM_GARMENTS_IMPORT" description="FTM Garments: preview and commit a SKU workbook import"/>

    <StatusType statusTypeId="FTM_SKU_IMPORT" description="FTM SKU workbook import"/>
    <StatusItem statusId="FTMSKU_PREVIEWED"  statusTypeId="FTM_SKU_IMPORT" statusCode="PREVIEWED"   sequenceId="01" description="Previewed, awaiting the ruling"/>
    <StatusItem statusId="FTMSKU_COMMITTED"  statusTypeId="FTM_SKU_IMPORT" statusCode="COMMITTED"   sequenceId="02" description="Committed"/>
    <StatusItem statusId="FTMSKU_ROLLEDBACK" statusTypeId="FTM_SKU_IMPORT" statusCode="ROLLED_BACK" sequenceId="03" description="Commit failed; nothing was kept"/>
    <StatusItem statusId="FTMSKU_REFUSED"    statusTypeId="FTM_SKU_IMPORT" statusCode="REFUSED"     sequenceId="04" description="Commit refused: the master or the sheet map changed since the preview"/>
    <StatusItem statusId="FTMSKU_ABANDONED"  statusTypeId="FTM_SKU_IMPORT" statusCode="ABANDONED"   sequenceId="05" description="Abandoned without a commit"/>
    <StatusValidChange statusId="FTMSKU_PREVIEWED" statusIdTo="FTMSKU_COMMITTED"  transitionName="Commit"/>
    <StatusValidChange statusId="FTMSKU_PREVIEWED" statusIdTo="FTMSKU_ROLLEDBACK" transitionName="Commit failed"/>
    <StatusValidChange statusId="FTMSKU_PREVIEWED" statusIdTo="FTMSKU_REFUSED"    transitionName="Commit refused"/>
    <StatusValidChange statusId="FTMSKU_PREVIEWED" statusIdTo="FTMSKU_ABANDONED"  transitionName="Abandon"/>
</entity-engine-xml>
