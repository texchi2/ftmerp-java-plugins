<?xml version="1.0" encoding="UTF-8"?>
<screens xmlns="http://ofbiz.apache.org/Widget-Screen"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://ofbiz.apache.org/Widget-Screen http://ofbiz.apache.org/dtds/widget-screen.xsd">

    <screen name="FindStyles">
        <section>
            <actions>
                <service service-name="getFtmStyles" result-map="serviceResult">
                    <field-map field-name="buyer"       from-field="parameters.buyer"/>
                    <field-map field-name="productType" from-field="parameters.productType"/>
                    <field-map field-name="status"      from-field="parameters.status"/>
                </service>
                <set field="styleList"  from-field="serviceResult.styleList"/>
                <set field="styleCount" from-field="serviceResult.styleCount"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator"
                    location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="FTM Styles (${styleCount} total)">
                            <include-form name="FindStylesFilter"
                               location="component://ftm-garments/widget/FtmGarmentsForms.xml"/>
                        </screenlet>
                        <screenlet title="Style List">
                            <include-form name="StyleList"
                               location="component://ftm-garments/widget/FtmGarmentsForms.xml"/>
                        </screenlet>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- SKU generator entry screen (PLAYBOOK_SKU S7) -->
    <screen name="SkuGenerator">
        <section>
            <actions>
                <script location="component://ftm-garments/groovyScripts/ftm/garments/SkuGeneratorPrep.groovy"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="SKU Generator">
                            <platform-specific>
                                <html><html-template location="component://ftm-garments/template/SkuGenerator.ftl"/></html>
                            </platform-specific>
                        </screenlet>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <screen name="CreateStyle">
        <section>
            <widgets>
                <decorator-screen name="main-decorator"
                    location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="Create New Style Number">
                            <include-form name="StyleNumberForm"
                               location="component://ftm-garments/widget/FtmGarmentsForms.xml"/>
                        </screenlet>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <screen name="EditStyle">
        <section>
            <actions>
                <service service-name="getFtmStyle" result-map="style">
                    <field-map field-name="styleNumberId" from-field="parameters.styleNumberId"/>
                </service>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator"
                    location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="Edit Style Number">
                            <include-form name="StyleNumberForm"
                               location="component://ftm-garments/widget/FtmGarmentsForms.xml"/>
                        </screenlet>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <screen name="DeleteStyle">
        <section>
            <widgets>
                <decorator-screen name="main-decorator"
                    location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="Delete Style Number">
                            <label text="Are you sure you want to delete style ${parameters.styleNumberId}?"/>
                            <include-form name="DeleteConfirm"
                               location="component://ftm-garments/widget/FtmGarmentsForms.xml"/>
                        </screenlet>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- ===== SKU workbook import (DESIGN_sku_workbook_import_2026-10-22): every screen behind login (controller) AND
         the FTM_GARMENTS_IMPORT permission; the services check the same permission, so the screens are not the fence. ===== -->
    <screen name="SkuImportUpload">
        <section>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><if-has-permission permission="FTM_GARMENTS" action="_IMPORT"/></condition>
                            <widgets>
                                <screenlet title="SKU workbook import - upload">
                                    <label text="Upload the owner's workbook (.xlsx). The master is not touched: the preview lists every difference, and only the rows ticked there are committed, in one transaction. The size limit is checked before anything is stored."/>
                                    <include-form name="SkuWorkbookUploadForm" location="component://ftm-garments/widget/FtmGarmentsForms.xml"/>
                                </screenlet>
                            </widgets>
                            <fail-widgets>
                                <label style="h3" text="The SKU workbook import needs the FTM_GARMENTS_IMPORT permission."/>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <screen name="SkuImportPreview">
        <section>
            <actions>
                <script location="component://ftm-garments/groovyScripts/ftm/garments/SkuImportPreviewActions.groovy"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><if-has-permission permission="FTM_GARMENTS" action="_IMPORT"/></condition>
                            <widgets>
                                <screenlet title="SKU workbook import - preview: the differences, for ruling">
                                    <platform-specific>
                                        <html><html-template location="component://ftm-garments/template/SkuImportPreview.ftl"/></html>
                                    </platform-specific>
                                </screenlet>
                            </widgets>
                            <fail-widgets>
                                <label style="h3" text="The SKU workbook import needs the FTM_GARMENTS_IMPORT permission."/>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <screen name="SkuImportSummary">
        <section>
            <actions>
                <script location="component://ftm-garments/groovyScripts/ftm/garments/SkuImportSummaryActions.groovy"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><if-has-permission permission="FTM_GARMENTS" action="_IMPORT"/></condition>
                            <widgets>
                                <screenlet title="SKU workbook import - summary and audit">
                                    <platform-specific>
                                        <html><html-template location="component://ftm-garments/template/SkuImportSummary.ftl"/></html>
                                    </platform-specific>
                                </screenlet>
                            </widgets>
                            <fail-widgets>
                                <label style="h3" text="The SKU workbook import needs the FTM_GARMENTS_IMPORT permission."/>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>
</screens>
