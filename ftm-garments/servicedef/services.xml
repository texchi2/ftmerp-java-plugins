<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/services.xsd">

    <description>FTM Garments Services</description>
    <vendor>FTM Garments Swaziland</vendor>
    <version>1.0</version>

    <service name="getFtmStyle" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmStyleNumberServices.groovy"
        invoke="getFtmStyle" auth="false">
        <description>Get a single FTM Style Number</description>
        <attribute name="styleNumberId" type="String" mode="IN" optional="false"/>
        <attribute name="styleNumber"   type="String" mode="OUT" optional="true"/>
        <attribute name="buyer"         type="String" mode="OUT" optional="true"/>
        <attribute name="description"   type="String" mode="OUT" optional="true"/>
        <attribute name="productType"   type="String" mode="OUT" optional="true"/>
        <attribute name="productCategory" type="String" mode="OUT" optional="true"/>
        <attribute name="season"        type="String" mode="OUT" optional="true"/>
        <attribute name="status"        type="String" mode="OUT" optional="true"/>
    </service>

    <service name="createFtmStyleNumber" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmStyleNumberServices.groovy"
        invoke="createFtmStyleNumber" auth="true">
        <description>Create FTM Style Number</description>
        <attribute name="styleNumber"      type="String"  mode="IN" optional="false"/>
        <attribute name="buyer"            type="String"  mode="IN" optional="false"/>
        <attribute name="description"      type="String"  mode="IN" optional="true"/>
        <attribute name="productType"      type="String"  mode="IN" optional="false"/>
        <attribute name="productCategory"  type="String"  mode="IN" optional="true"/>
        <attribute name="season"           type="String"  mode="IN" optional="true"/>
        <attribute name="status"           type="String"  mode="IN" optional="false"/>
        <attribute name="styleNumberId"    type="String"  mode="OUT" optional="false"/>
    </service>

    <service name="updateFtmStyleNumber" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmStyleNumberServices.groovy"
        invoke="updateFtmStyleNumber" auth="true">
        <description>Update FTM Style Number</description>
        <attribute name="styleNumberId"    type="String"  mode="IN" optional="false"/>
        <attribute name="styleNumber"      type="String"  mode="IN" optional="true"/>
        <attribute name="buyer"            type="String"  mode="IN" optional="true"/>
        <attribute name="description"      type="String"  mode="IN" optional="true"/>
        <attribute name="productType"      type="String"  mode="IN" optional="true"/>
        <attribute name="productCategory"  type="String"  mode="IN" optional="true"/>
        <attribute name="season"           type="String"  mode="IN" optional="true"/>
        <attribute name="status"           type="String"  mode="IN" optional="true"/>
    </service>

    <service name="deleteFtmStyleNumber" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmStyleNumberServices.groovy"
        invoke="deleteFtmStyleNumber" auth="true">
        <description>Delete FTM Style Number</description>
        <attribute name="styleNumberId"    type="String"  mode="IN" optional="false"/>
    </service>

    <service name="getFtmStyles" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/GetStyles.groovy"
        invoke="getFtmStyles" auth="false">
        <description>Find FTM Style Numbers with filters</description>
        <attribute name="buyer"        type="String"  mode="IN" optional="true"/>
        <attribute name="productType"  type="String"  mode="IN" optional="true"/>
        <attribute name="status"       type="String"  mode="IN" optional="true"/>
        <attribute name="styleList"    type="List"    mode="OUT" optional="true"/>
        <attribute name="styleCount"   type="Integer" mode="OUT" optional="true"/>
    </service>

    <!-- ===== Project NEITH Phase 2: size-curve order expansion ===== -->
    <service name="expandSizeCurveToVariants" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmSizeCurveServices.groovy"
        invoke="expandSizeCurveToVariants" auth="false">
        <description>NEITH: expand (virtual style + colours + size-curve + per-colour qty) into per-variant SKU quantities</description>
        <attribute name="productId"         type="String"     mode="IN"  optional="false"/>
        <attribute name="sizeCurveId"       type="String"     mode="IN"  optional="false"/>
        <attribute name="quantityPerColor"  type="BigDecimal" mode="IN"  optional="false"/>
        <attribute name="colorFeatureIds"   type="List"       mode="IN"  optional="true"/>
        <attribute name="variantQuantities" type="List"       mode="OUT" optional="false"/>
        <attribute name="totalQuantity"     type="BigDecimal" mode="OUT" optional="true"/>
    </service>

    <service name="createVariantsFromSizeCurve" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmSizeCurveServices.groovy"
        invoke="createVariantsFromSizeCurve" auth="true">
        <description>PLAYBOOK_SKU S4: create the variant Products of a virtual style, one per colour x size on the curve,
            each with exactly one COLOR and one SIZE standard feature (via quickAddVariant). Idempotent; an existing
            product that blocks a variant id is refused, never overwritten.</description>
        <attribute name="productId"          type="String"  mode="IN"  optional="false"/>
        <attribute name="sizeCurveId"        type="String"  mode="IN"  optional="false"/>
        <attribute name="colorFeatureIds"    type="List"    mode="IN"  optional="true"/>
        <attribute name="createdVariantIds"  type="List"    mode="OUT" optional="false"/>
        <attribute name="existingVariantIds" type="List"    mode="OUT" optional="false"/>
        <attribute name="variantCount"       type="Integer" mode="OUT" optional="false"/>
    </service>

    <!-- ===== SKU generator (PLAYBOOK_SKU S2) ===== -->
    <service name="generateTrimSku" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmSkuServices.groovy"
        invoke="generateTrimSku" auth="false" use-transaction="false">
        <description>Pure: compute the SKU code of an item from its attribute values (by segment inputName) and/or
            chosen ProductFeature ids. Refuses when a FEATURE value has no matching feature or an input is missing.
            Writes nothing.</description>
        <attribute name="skuRuleId"         type="String" mode="IN"  optional="false"/>
        <attribute name="values"            type="Map"    mode="IN"  optional="true"/>
        <attribute name="productFeatureIds" type="List"   mode="IN"  optional="true"/>
        <attribute name="skuCode"           type="String" mode="OUT" optional="false"/>
        <attribute name="canonicalCode"     type="String" mode="OUT" optional="false"/>
        <attribute name="lengthValid"       type="Boolean" mode="OUT" optional="false"/>
        <attribute name="featureIds"        type="List"   mode="OUT" optional="false"/>
        <attribute name="attributes"        type="Map"    mode="OUT" optional="false"/>
    </service>

    <service name="createTrimProduct" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmSkuServices.groovy"
        invoke="createTrimProduct" auth="true">
        <description>Create (or return) the raw-material Product for an item: features applied, segment inputs as
            ProductAttribute, GoodIdentification SKU = canonical code (+ FTM_SKU_DASHED alias when the rule emits dashes).
            Idempotent: the same item twice returns the same product. A code already held by an item with different
            attributes is REFUSED, never overwritten. A code of the wrong length is refused.</description>
        <attribute name="skuRuleId"         type="String" mode="IN"  optional="false"/>
        <attribute name="values"            type="Map"    mode="IN"  optional="true"/>
        <attribute name="productFeatureIds" type="List"   mode="IN"  optional="true"/>
        <attribute name="productName"       type="String" mode="IN"  optional="true"/>
        <attribute name="productId"         type="String" mode="OUT" optional="false"/>
        <attribute name="canonicalCode"     type="String" mode="OUT" optional="false"/>
        <attribute name="created"           type="Boolean" mode="OUT" optional="false"/>
    </service>

    <service name="assignGarmentSkus" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmGarmentSkuServices.groovy"
        invoke="assignGarmentSkus" auth="true">
        <description>PLAYBOOK_SKU S5: give every variant of a style its garment SKU (GoodIdentification SKU, + dashed
            alias), composed by an FtmSkuRule from STYLE / STYLE_ID and the variant's colour and size features.
            SWITCHED OFF unless ftm-garments / garmentSku.enabled = Y (SystemProperty overrides the properties file).
            All codes are checked before any is written; a used code, a wrong length or a different existing SKU
            refuses the whole style.</description>
        <attribute name="productId"       type="String" mode="IN"  optional="false"/>
        <attribute name="skuRuleId"       type="String" mode="IN"  optional="true"/>
        <attribute name="assigned"        type="List"   mode="OUT" optional="false"/>
        <attribute name="alreadyAssigned" type="List"   mode="OUT" optional="false"/>
    </service>

    <service name="assignCustomerSkus" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmGarmentSkuServices.groovy"
        invoke="assignCustomerSkus" auth="true">
        <description>Record a customer's own per-size item codes on a style's variants of one colour, as GoodIdentification
            of a customer type (child of FTM_CUSTOMER_SKU). All checked before any write; a code already used, or a
            variant holding a different code, refuses the whole call.</description>
        <attribute name="productId"                type="String" mode="IN"  optional="false"/>
        <attribute name="colorFeatureId"           type="String" mode="IN"  optional="false"/>
        <attribute name="goodIdentificationTypeId" type="String" mode="IN"  optional="false"/>
        <attribute name="skuBySizeFeatureId"       type="Map"    mode="IN"  optional="false"/>
        <attribute name="assigned"                 type="List"   mode="OUT" optional="false"/>
        <attribute name="alreadyAssigned"          type="List"   mode="OUT" optional="false"/>
    </service>

    <!-- ===== Garment BOM + colour package (PLAYBOOK_SKU S6) ===== -->
    <service name="setColourPackage" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmBomServices.groovy"
        invoke="setColourPackage" auth="true">
        <description>One colour-package row: on style X, garment colour C takes trim T for the virtual BOM line V
            (a ProductManufacturingRule). Idempotent; a different existing mapping is refused, never overwritten.</description>
        <attribute name="productId"             type="String" mode="IN"  optional="false"/>
        <attribute name="garmentColorFeatureId" type="String" mode="IN"  optional="false"/>
        <attribute name="componentProductId"    type="String" mode="IN"  optional="false"/>
        <attribute name="trimProductId"         type="String" mode="IN"  optional="false"/>
        <attribute name="quantity"              type="BigDecimal" mode="IN" optional="true"/>
        <attribute name="ruleId"                type="String" mode="OUT" optional="true"/>
        <attribute name="created"               type="Boolean" mode="OUT" optional="false"/>
    </service>

    <service name="getVariantBom" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmBomServices.groovy"
        invoke="getVariantBom" auth="true">
        <description>The resolved single-level BOM of a garment variant (OFBiz explosion, colour package applied), with
            quantities for the given garment quantity. Refuses when a trim is left unresolved (still virtual).</description>
        <attribute name="productId"              type="String"     mode="IN"  optional="false"/>
        <attribute name="quantity"               type="BigDecimal" mode="IN"  optional="true"/>
        <attribute name="requireResolved"        type="Boolean"    mode="IN"  optional="true"/>
        <attribute name="components"             type="List"       mode="OUT" optional="false"/>
        <attribute name="unresolvedComponentIds" type="List"       mode="OUT" optional="false"/>
    </service>

    <service name="importSkuRows" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmSkuServices.groovy"
        invoke="importSkuRows" auth="true" use-transaction="false">
        <description>PLAYBOOK_SKU S7: one-time import of existing codes. Each row [ref, skuRuleId, values, workbookCode,
            productName?] ends in exactly one of loaded / alreadyPresent / refusedAsWorkbook / disagreeing (listed, nothing
            created); the counts add up to the rows given. Each creation runs in its own transaction. Codes are composed by
            a direct call (no nested service), so an expected refusal never marks a transaction rollback-only. dryRun = the same
            classification, nothing written. expectCounts (loaded, alreadyPresent, refusedAsWorkbook, disagreeing) = the
            whole import in ONE transaction, committed only if every count matches.</description>
        <attribute name="rows"              type="List"    mode="IN"  optional="false"/>
        <attribute name="dryRun"            type="Boolean" mode="INOUT" optional="true"/>
        <attribute name="expectCounts"      type="Map"     mode="IN"  optional="true"/>
        <attribute name="loaded"            type="List"    mode="OUT" optional="false"/>
        <attribute name="alreadyPresent"    type="List"    mode="OUT" optional="false"/>
        <attribute name="refusedAsWorkbook" type="List"    mode="OUT" optional="false"/>
        <attribute name="disagreeing"       type="List"    mode="OUT" optional="false"/>
        <attribute name="rowCount"          type="Integer" mode="OUT" optional="false"/>
    </service>

    <service name="findProductBySku" engine="groovy"
        location="component://ftm-garments/groovyScripts/ftm/garments/FtmSkuServices.groovy"
        invoke="findProductBySku" auth="true">
        <description>Find the product of an SKU code given in either form (dashed or undashed).</description>
        <attribute name="skuCode"   type="String" mode="IN"  optional="false"/>
        <attribute name="productId" type="String" mode="OUT" optional="true"/>
    </service>

</services>
