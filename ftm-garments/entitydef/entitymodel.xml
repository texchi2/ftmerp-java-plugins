<?xml version="1.0" encoding="UTF-8"?>
<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/entitymodel.xsd">

    <title>FTM Garments Entity Model</title>
    <description>Entity definitions for FTM Garments customizations</description>
    <version>1.0</version>

    <entity entity-name="FtmStyleNumber" package-name="org.apache.ofbiz.ftm.garments"
        title="FTM Style Number" author="FTM Garments" version="1.0">
        <field name="styleNumberId"    type="id"/>
        <field name="styleNumber"      type="short-varchar"/>
        <field name="buyer"            type="short-varchar"/>
        <field name="description"      type="description"/>
        <field name="productType"      type="short-varchar"/>
        <field name="productCategory"  type="short-varchar"/>
        <field name="season"           type="short-varchar"/>
        <field name="status" type="short-varchar" col-name="style_status"/>
        <field name="productId"        type="id"/>
        <field name="createdDate"      type="date-time"/>
        <field name="lastModifiedDate" type="date-time"/>
        <prim-key field="styleNumberId"/>
    </entity>

    <!-- ===== Project NEITH Phase 2: size curve (order pack ratios) ===== -->
    <entity entity-name="FtmSizeCurve" package-name="org.apache.ofbiz.ftm.garments"
        title="FTM Size Curve" author="FTM Garments (NEITH)" version="1.0">
        <field name="sizeCurveId"              type="id"/>
        <field name="description"              type="description"/>
        <field name="productFeatureCategoryId" type="id"/>
        <field name="createdDate"              type="date-time"/>
        <field name="lastModifiedDate"         type="date-time"/>
        <prim-key field="sizeCurveId"/>
        <relation type="one" fk-name="FTM_SZCRV_PFC" rel-entity-name="ProductFeatureCategory">
            <key-map field-name="productFeatureCategoryId"/>
        </relation>
    </entity>

    <entity entity-name="FtmSizeCurveItem" package-name="org.apache.ofbiz.ftm.garments"
        title="FTM Size Curve Item (per-size ratio)" author="FTM Garments (NEITH)" version="1.0">
        <field name="sizeCurveId"   type="id"/>
        <field name="sizeFeatureId" type="id"/>
        <field name="ratio"         type="fixed-point"/>
        <field name="sequenceNum"   type="numeric"/>
        <prim-key field="sizeCurveId"/>
        <prim-key field="sizeFeatureId"/>
        <relation type="one" fk-name="FTM_SZITM_CRV" rel-entity-name="FtmSizeCurve">
            <key-map field-name="sizeCurveId"/>
        </relation>
        <relation type="one" fk-name="FTM_SZITM_PF" rel-entity-name="ProductFeature">
            <key-map field-name="sizeFeatureId" rel-field-name="productFeatureId"/>
        </relation>
    </entity>

    <!-- ===== SKU generator: a rule per item category = ordered segments (playbook PLAYBOOK_SKU S2) =====
         The rule rows and the lookup features are DATA, loaded from the owner's workbooks through a
         private seed; nothing workbook-derived lives in this repository. -->
    <entity entity-name="FtmSkuRule" package-name="org.apache.ofbiz.ftm.garments"
        title="FTM SKU Rule" author="FTM Garments" version="1.0">
        <field name="skuRuleId"   type="id"/>
        <field name="description" type="description"/>
        <field name="codeLength"  type="numeric"><description>Required length of the canonical (undashed) code</description></field>
        <prim-key field="skuRuleId"/>
    </entity>

    <entity entity-name="FtmSkuRuleSegment" package-name="org.apache.ofbiz.ftm.garments"
        title="FTM SKU Rule Segment" author="FTM Garments" version="1.0">
        <field name="skuRuleId"            type="id"/>
        <field name="sequenceNum"          type="numeric"/>
        <field name="segmentTypeId"        type="id"><description>LITERAL | INPUT | TEXT | FEATURE</description></field>
        <field name="literalText"          type="short-varchar"/>
        <field name="inputName"            type="description"><description>Key of the caller's value for this segment</description></field>
        <field name="productFeatureTypeId" type="id"><description>FEATURE: the value is matched to ProductFeature.description of this type; idCode is emitted</description></field>
        <field name="textOps"              type="short-varchar"><description>TEXT: ops applied in order, e.g. LEFT:3|UPPER|TRIM</description></field>
        <field name="allowedFeatureTypeId" type="id"><description>INPUT/TEXT: when set, the value must be one of this type's ProductFeature descriptions (the workbook's drop-down list)</description></field>
        <prim-key field="skuRuleId"/>
        <prim-key field="sequenceNum"/>
        <relation type="one" fk-name="FTM_SKUSEG_RULE" rel-entity-name="FtmSkuRule">
            <key-map field-name="skuRuleId"/>
        </relation>
        <relation type="one" fk-name="FTM_SKUSEG_PFT" rel-entity-name="ProductFeatureType">
            <key-map field-name="productFeatureTypeId"/>
        </relation>
        <relation type="one" fk-name="FTM_SKUSEG_ALW" title="Allowed" rel-entity-name="ProductFeatureType">
            <key-map field-name="allowedFeatureTypeId" rel-field-name="productFeatureTypeId"/>
        </relation>
    </entity>

</entitymodel>
