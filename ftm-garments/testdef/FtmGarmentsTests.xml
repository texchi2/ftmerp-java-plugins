<!--
  ftm-garments integration tests. Run from the framework root after the
  NEITH demo data is loaded (see NEITH.md):
    ./gradlew "ofbiz [double-dash]test component=ftm-garments"
  (XML forbids a double dash inside a comment, hence the placeholder.)
  The entity-xml case ASSERTS (never loads) that the style-matrix demo rows are in
  the database. The size-curve rows are checked in SizeCurveTests instead: entity-xml
  assert compares fixed-point as text, so ratio "1" in the file never equals "1.000000".
-->
<test-suite suite-name="ftmgarmentstests"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/test-suite.xsd">
    <test-case case-name="neith-style-matrix-demo-present">
        <entity-xml action="assert" entity-xml-url="component://ftm-garments/data/NeithStyleMatrixDemoData.xml"/>
    </test-case>
    <test-case case-name="load-style-variant-test-data">
        <entity-xml action="load" entity-xml-url="component://ftm-garments/testdef/data/FtmStyleVariantTestData.xml"/>
    </test-case>
    <test-case case-name="style-variant-tests">
        <junit-test-suite class-name="org.apache.ofbiz.ftm.garments.test.StyleVariantTests"/>
    </test-case>
    <test-case case-name="size-curve-tests">
        <junit-test-suite class-name="org.apache.ofbiz.ftm.garments.test.SizeCurveTests"/>
    </test-case>
</test-suite>
