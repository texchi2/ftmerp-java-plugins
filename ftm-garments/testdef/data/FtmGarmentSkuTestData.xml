<!-- SYNTHETIC garment SKU rule and styles for assignGarmentSkus - invented values; FTM's own garment rule is not
     written yet (it is the owner's). TEST_GARMENT emits  G + style number + "-" + colour code + size code. -->
<entity-engine-xml>
    <ProductFeature productFeatureId="TG_CLR_RD" productFeatureTypeId="COLOR" description="Test red" abbrev="RD" idCode="RD"/>
    <ProductFeature productFeatureId="TG_CLR_BL" productFeatureTypeId="COLOR" description="Test blue" abbrev="BL" idCode="BL"/>
    <ProductFeature productFeatureId="TG_SZ_S" productFeatureTypeId="SIZE" description="Test small" abbrev="S" idCode="S"/>
    <ProductFeature productFeatureId="TG_SZ_M" productFeatureTypeId="SIZE" description="Test medium" abbrev="M" idCode="M"/>

    <FtmSkuRule skuRuleId="TEST_GARMENT" description="Synthetic garment rule" codeLength="8"/>
    <FtmSkuRuleSegment skuRuleId="TEST_GARMENT" sequenceNum="10" segmentTypeId="LITERAL" literalText="G"/>
    <FtmSkuRuleSegment skuRuleId="TEST_GARMENT" sequenceNum="20" segmentTypeId="INPUT" inputName="STYLE"/>
    <FtmSkuRuleSegment skuRuleId="TEST_GARMENT" sequenceNum="30" segmentTypeId="LITERAL" literalText="-"/>
    <FtmSkuRuleSegment skuRuleId="TEST_GARMENT" sequenceNum="40" segmentTypeId="FEATURE" inputName="COLOUR" productFeatureTypeId="COLOR"/>
    <FtmSkuRuleSegment skuRuleId="TEST_GARMENT" sequenceNum="50" segmentTypeId="FEATURE" inputName="SIZE" productFeatureTypeId="SIZE"/>

    <!-- style 1: 2 colours x 2 sizes, style number TG01 -->
    <Product productId="TEST_GSTYLE1" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="TEST_GSTYLE1"/>
    <FtmStyleNumber styleNumberId="TEST_TG01" styleNumber="TG01" buyer="TEST" productType="Trouser" status="ACTIVE" productId="TEST_GSTYLE1"/>
    <Product productId="TEST_G1_RD_S" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="TEST_G1_RD_S"/>
    <Product productId="TEST_G1_RD_M" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="TEST_G1_RD_M"/>
    <Product productId="TEST_G1_BL_S" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="TEST_G1_BL_S"/>
    <Product productId="TEST_G1_BL_M" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="TEST_G1_BL_M"/>
    <ProductAssoc productId="TEST_GSTYLE1" productIdTo="TEST_G1_RD_S" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-10-01 00:00:00.0"/>
    <ProductAssoc productId="TEST_GSTYLE1" productIdTo="TEST_G1_RD_M" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-10-01 00:00:00.0"/>
    <ProductAssoc productId="TEST_GSTYLE1" productIdTo="TEST_G1_BL_S" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-10-01 00:00:00.0"/>
    <ProductAssoc productId="TEST_GSTYLE1" productIdTo="TEST_G1_BL_M" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_RD_S" productFeatureId="TG_CLR_RD" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_RD_S" productFeatureId="TG_SZ_S" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_RD_M" productFeatureId="TG_CLR_RD" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_RD_M" productFeatureId="TG_SZ_M" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_BL_S" productFeatureId="TG_CLR_BL" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_BL_S" productFeatureId="TG_SZ_S" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_BL_M" productFeatureId="TG_CLR_BL" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G1_BL_M" productFeatureId="TG_SZ_M" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>

    <!-- style 2: 2 variants; the code of its blue/M variant is already held by another product -->
    <Product productId="TEST_GSTYLE2" productTypeId="FINISHED_GOOD" isVirtual="Y" isVariant="N" internalName="TEST_GSTYLE2"/>
    <FtmStyleNumber styleNumberId="TEST_TG02" styleNumber="TG02" buyer="TEST" productType="Trouser" status="ACTIVE" productId="TEST_GSTYLE2"/>
    <Product productId="TEST_G2_RD_S" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="TEST_G2_RD_S"/>
    <Product productId="TEST_G2_BL_M" productTypeId="FINISHED_GOOD" isVirtual="N" isVariant="Y" internalName="TEST_G2_BL_M"/>
    <ProductAssoc productId="TEST_GSTYLE2" productIdTo="TEST_G2_RD_S" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-10-01 00:00:00.0"/>
    <ProductAssoc productId="TEST_GSTYLE2" productIdTo="TEST_G2_BL_M" productAssocTypeId="PRODUCT_VARIANT" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G2_RD_S" productFeatureId="TG_CLR_RD" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G2_RD_S" productFeatureId="TG_SZ_S" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G2_BL_M" productFeatureId="TG_CLR_BL" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <ProductFeatureAppl productId="TEST_G2_BL_M" productFeatureId="TG_SZ_M" productFeatureApplTypeId="STANDARD_FEATURE" fromDate="2026-10-01 00:00:00.0"/>
    <Product productId="TEST_G_SQUAT" productTypeId="RAW_MATERIAL" isVirtual="N" isVariant="N" internalName="TEST_G_SQUAT"/>
    <GoodIdentification goodIdentificationTypeId="SKU" productId="TEST_G_SQUAT" idValue="GTG02BLM"/>
</entity-engine-xml>
