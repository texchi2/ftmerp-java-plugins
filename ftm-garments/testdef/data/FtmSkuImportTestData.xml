<!-- SYNTHETIC sheet map for the workbook-import tests (rule TEST_SKU from FtmSkuTestData.xml). No real item data. -->
<entity-engine-xml>
    <!-- a numeric-coded list the import can mint the next code for (01, 02 -> 03) -->
    <ProductFeatureType productFeatureTypeId="SKU_TEST_SIZE" description="Test SKU size"/>
    <ProductFeature productFeatureId="SKU_TEST_S_01" productFeatureTypeId="SKU_TEST_SIZE" description="Small" idCode="01" defaultSequenceNum="1"/>
    <ProductFeature productFeatureId="SKU_TEST_S_02" productFeatureTypeId="SKU_TEST_SIZE" description="Medium" idCode="02" defaultSequenceNum="2"/>

    <!-- the synthetic workbook's sheets: a colour list whose codes are compared, a size list, an item list -->
    <FtmSkuSheetMap sheetMapId="TEST_COLOURS" sheetName="Test Colours" mapKindId="VOCAB" skuRuleId="TEST_SKU" description="synthetic colour list"/>
    <FtmSkuSheetColumn sheetMapId="TEST_COLOURS" columnSeq="1" keyHeader="Colour" codeHeader="Code" nameHeader="Note"
        productFeatureTypeId="SKU_TEST_COLOR" compareCode="Y"/>
    <FtmSkuSheetMap sheetMapId="TEST_SIZES" sheetName="Test Sizes" mapKindId="VOCAB" skuRuleId="TEST_SKU" description="synthetic size list"/>
    <FtmSkuSheetColumn sheetMapId="TEST_SIZES" columnSeq="1" keyHeader="Size" productFeatureTypeId="SKU_TEST_SIZE" compareCode="N"/>
    <FtmSkuSheetMap sheetMapId="TEST_ITEMS" sheetName="Test Items" mapKindId="ITEMS" skuRuleId="TEST_SKU" codeHeader="SKU" description="synthetic item list"/>
    <!-- v0.3: an item list whose Seq cells carry a unit and a decimal (STRIP_UNIT|NUMBER), and one with an unknown op -->
    <FtmSkuSheetMap sheetMapId="TEST_ITEMS_OPS" sheetName="Test Items Ops" mapKindId="ITEMS" skuRuleId="TEST_SKU" codeHeader="SKU" description="synthetic item list with value ops"/>
    <FtmSkuSheetColumn sheetMapId="TEST_ITEMS_OPS" columnSeq="1" keyHeader="Seq" valueOps="STRIP_UNIT|NUMBER"/>
    <FtmSkuSheetMap sheetMapId="TEST_ITEMS_BAD" sheetName="Test Items Bad" mapKindId="ITEMS" skuRuleId="TEST_SKU" codeHeader="SKU" description="synthetic item list with an unknown op"/>
    <FtmSkuSheetColumn sheetMapId="TEST_ITEMS_BAD" columnSeq="1" keyHeader="Seq" valueOps="FOO"/>

    <!-- the test runner's login (system) sits in the seed group SUPER: grant the import permission there, for the tests only
         (the test database holds seed data only - no FULLADMIN) -->
    <SecurityGroupPermission groupId="SUPER" permissionId="FTM_GARMENTS_IMPORT" fromDate="2026-10-01 00:00:00"/>

    <!-- a login in no security group: both import services must refuse it -->
    <UserLogin userLoginId="skuimport-nobody" currentPassword="{SHA}47b56994cbc2b6d10aa1be30f70165adb305a41a" enabled="Y" requirePasswordChange="N"/>
</entity-engine-xml>
