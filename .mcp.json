{
  "mcpServers": {
    "ftm-gitea": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITEA_TOKEN}",
        "GITHUB_API_URL": "${GITEA_API_URL}"
      }
    },
    "ftm-postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_CONNECTION_STRING": "${FTM_DB_URL}"
      }
    },
    "ftm-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~/development/ofbiz-plugins",
        "~/development/ofbiz-framework"
      ]
    }
  }
}
